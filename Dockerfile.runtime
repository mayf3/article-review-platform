FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV NODE_OPTIONS=--max-old-space-size=256

COPY package*.json ./
COPY node_modules ./node_modules
COPY src ./src
COPY dist/client ./dist/client
COPY tsconfig.json ./

RUN apk add --no-cache dumb-init

EXPOSE 3000
CMD ["dumb-init", "npx", "tsx", "src/server/index.ts"]
